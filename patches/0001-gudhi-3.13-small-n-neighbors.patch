+BOOST_AUTO_TEST_CASE(neighbors_finder_small_linear_scan) {
+  std::vector<std::pair<double, double>> first = {{0., 0.2}, {0.3, 0.5}, {0.8, 1.0}};
+  std::vector<std::pair<double, double>> second = {{0.01, 0.21}, {0.31, 0.51}, {0.79, 0.99}};
+  Persistence_graph graph(first, second, 0.);
+  BOOST_REQUIRE(graph.size() <= 256);
+  constexpr double radius = 0.02;
+  for (int u_point_index = 0; u_point_index < graph.size(); ++u_point_index) {
+    Neighbors_finder finder(graph, radius);
+    for (int v_point_index = 0; v_point_index < graph.size(); ++v_point_index)
+      finder.add(v_point_index);
+
+    std::vector<int> actual = finder.pull_all_near(u_point_index);
+    std::vector<int> expected;
+    for (int v_point_index = 0; v_point_index < graph.size(); ++v_point_index) {
+      if (graph.distance(u_point_index, v_point_index) <= radius)
+        expected.emplace_back(v_point_index);
+    }
+    std::sort(actual.begin(), actual.end());
+    std::sort(expected.begin(), expected.end());
+    BOOST_CHECK_EQUAL_COLLECTIONS(actual.begin(), actual.end(), expected.begin(), expected.end());
+  }
+}
